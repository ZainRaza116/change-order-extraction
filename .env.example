# Copy to .env and fill in. Never commit .env.

# Which LLM provider to use: anthropic or openai. Fill in the matching key.
CO_EXTRACT_PROVIDER=openai
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Models (leave unset for the provider's defaults:
#   anthropic -> claude-sonnet-5-5 / claude-opus-5-5, openai -> gpt-4o-mini / gpt-4o)
# CO_EXTRACT_MODEL=
# CO_EXTRACT_ESCALATION_MODEL=
# 1 = re-run documents that need review on the escalation model (extra cost per such doc)
CO_EXTRACT_ESCALATE=0
CO_EXTRACT_EFFORT=medium
# Sent only to models that accept sampling parameters; current Claude models reject them.
CO_EXTRACT_TEMPERATURE=0

# Scanned pages whose Tesseract confidence is low can be re-read by a vision model (costs API calls).
CO_EXTRACT_VISION_FALLBACK=0
CO_EXTRACT_VISION_MODEL=claude-opus-5-5

# Documents with any required field below this confidence are flagged needs_review.
CO_EXTRACT_REVIEW_THRESHOLD=0.7

# LLM responses are recorded here, keyed by a hash of the full request (committed, so
# reviewers can replay results without an API key).
#   auto    = replay if recorded, otherwise call the API and record
#   replay  = recorded responses only, never call the API
#   refresh = always call the API and overwrite the recording
CO_EXTRACT_LLM_MODE=auto
CO_EXTRACT_CACHE_DIR=cassettes
